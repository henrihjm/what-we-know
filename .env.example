# ---- OpenAI (merge model; required for live cycles) ----
OPENAI_API_KEY=
OPENAI_MODEL=            # empty = check-env picks the newest general model the key can access

# ---- Nimble (search + page extract) ----
NIMBLE_API_KEY=

# ---- Tinybird RawTree (persistence, all events) ----
RAWTREE_API_KEY=
RAWTREE_DATABASE=        # optional, sent as x-rawtree-database header

# ---- Liquid AI triage model (OpenAI-compatible endpoint; never local) ----
# OpenRouter: TRIAGE_BASE_URL=https://openrouter.ai/api/v1  TRIAGE_MODEL=liquid/lfm-2.5-2.6b:free  TRIAGE_API_KEY=<openrouter key>
# No OpenRouter key -> triage runs on the OpenAI mini model (TRIAGE_FALLBACK_MODEL, default gpt-4.1-mini).
# Local endpoints (localhost:11434 etc.) are ignored on purpose.
TRIAGE_BASE_URL=
TRIAGE_MODEL=
TRIAGE_API_KEY=
OPENROUTER_API_KEY=

# ---- AWS Bedrock (summary rewrite) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=        # e.g. us.anthropic.claude-sonnet-4-20250514-v1:0 or amazon.nova-lite-v1:0

# ---- Black Forest Labs FLUX (situation cards) ----
BFL_API_KEY=

# ---- Broccoli (fix tickets; optional, unverified sponsor) ----
BROCCOLI_API_URL=
BROCCOLI_API_KEY=

# ---- Loop tuning ----
MAX_TOKENS_PER_CYCLE=150000    # cloud-model tokens per cycle; remaining snippets are skipped above this
CYCLE_INTERVAL_SECONDS=300
CONTACT_EMAIL=henri.makivirta@gmail.com   # sent in NWS User-Agent
DASHBOARD_PORT=3000
